  "collected_at": "2026-08-08T01:05:40Z",
  "evidence_version": 1,
  "findings": [
    {
      "detail": "worker-service-below-capacity watched ECS/ContainerInsights/RunningTaskCount while the cluster set containerInsights=disabled, so the metric was never published and the alarm sat in ALARM from creation. Fixed by enabling Container Insights; verified ALARM->OK at 00:43:10Z once datapoints appeared, then OK->ALARM at 01:02:10Z when the service was scaled to zero.",
      "id": "container-insights-disabled",
      "status": "fixed and verified"
    },
    {
      "detail": "runs has UNIQUE (workspace_id, declared_bundle_digest) with no state predicate, so re-uploading the identical bundle after DELETE /v1/runs/{id} returns 409 permanently.",
      "id": "deleted-run-digest-not-released",
      "status": "open"
    },
    {
      "detail": "Worker tasks exited with code 1 during the partition: run_once does not supervise the failure of a control-plane request, so the process ends and ECS restarts it. Recovery worked, but a supervised loop would be quieter.",
      "id": "worker-exits-on-control-plane-partition",
      "status": "open"
    }
  ],
