{
  "$defs": {
    "JobNotification": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "job_version": {
          "minimum": 1,
          "title": "Job Version",
          "type": "integer"
        },
        "operation": {
          "enum": [
            "validate",
            "diff",
            "otlp",
            "pprof"
          ],
          "title": "Operation",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "traceparent": {
          "anyOf": [
            {
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        }
      },
      "required": [
        "protocol_version",
        "job_id",
        "job_version",
        "operation"
      ],
      "title": "JobNotification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "notification": {
      "$ref": "#/$defs/JobNotification"
    },
    "protocol_version": {
      "const": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "worker_id": {
      "format": "uuid",
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "notification",
    "worker_id"
  ],
  "title": "ClaimRequest",
  "type": "object"
}
