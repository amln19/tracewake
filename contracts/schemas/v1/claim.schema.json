{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "object_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Object Key",
          "type": "string"
        },
        "object_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Name"
        },
        "schema_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "object_key",
        "object_version",
        "digest",
        "size",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_number": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "attempt_token": {
      "maxLength": 256,
      "minLength": 43,
      "title": "Attempt Token",
      "type": "string"
    },
    "input_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Input Artifacts",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "lease_expires_at": {
      "format": "date-time",
      "title": "Lease Expires At",
      "type": "string"
    },
    "operation": {
      "enum": [
        "validate",
        "diff",
        "otlp",
        "pprof"
      ],
      "title": "Operation",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "const": "lexical-v1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "protocol_version": {
      "const": 1,
      "title": "Protocol Version",
      "type": "integer"
    }
  },
  "required": [
    "protocol_version",
    "job_id",
    "attempt_number",
    "attempt_token",
    "lease_expires_at",
    "input_artifacts",
    "operation"
  ],
  "title": "Claim",
  "type": "object"
}
